# Окружение для docker-compose.prod.yml. Скопируйте в .env.docker (он в .gitignore).

# Порт, на котором nginx доступен снаружи
HTTP_PORT=8080

APP_NAME=Avto
APP_ENV=production
# Сгенерировать: docker compose --env-file .env.docker -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=avto
DB_USERNAME=avto
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
# Не короче 16 символов (требование Meilisearch в production)
MEILISEARCH_KEY=change-me-to-a-long-random-key

FILESYSTEM_DISK=local
MAIL_MAILER=log
